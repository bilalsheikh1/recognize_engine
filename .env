# Is file ko .env naam se copy karein aur values badal dein
SECRET_KEY=change-me
ADMIN_KEY=admin

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Root@123
DB_NAME=face_attendance

# CCTV RTSP urls (config.py ke CAMERAS array mein use hotay hain)
CCTV_1=rtsp://admin:password@192.168.1.64:554/Streaming/Channels/101
CCTV_2=rtsp://admin:password@192.168.1.65:554/Streaming/Channels/101

# NVIDIA GPU ho to 1
USE_GPU=0
# LAN ke doosre PC se webcam use karna ho to HTTPS (self-signed) cert files
# SSL_CERT=cert.pem
# SSL_KEY=key.pem
